# Copie este arquivo para `.env` e preencha os valores.
# Nunca commite o arquivo `.env` (ele já está no .gitignore).

# Chave secreta do Django (obrigatória). Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
CHAVE_SECRETA=

# 'True' ativa o modo de desenvolvimento (erros detalhados, media servida localmente)
DEBUG=False

# URL do banco PostgreSQL (obrigatória), no formato suportado pelo dj-database-url.
# Exemplos:
#   DATABASE_URL=postgres://usuario:senha@localhost:5432/biblioteca
#   DATABASE_URL=postgres://usuario:senha@host.supabase.co:5432/postgres
DATABASE_URL=

# Hosts permitidos, separados por vírgula.
# Opcional: quando ALLOWED_HOSTS não é definida, o Django usa automaticamente:
#   • DEBUG=True  → localhost,127.0.0.1 (desenvolvimento)
#   • DEBUG=False → biblioteca-c1ca.onrender.com (produção)
ALLOWED_HOSTS=

# Origens confiáveis para CSRF (HTTPS), separadas por vírgula
CSRF_TRUSTED_ORIGINS=https://biblioteca-c1ca.onrender.com

# Chave de API da Brevo (envio de e-mails transacionais)
BREVO_API_KEY=

# Remetente e e-mail de resposta usados nos e-mails automáticos
DEFAULT_FROM_EMAIL=Sistema Biblioteca <seu.email@gmail.com>
EMAIL_REPLY_TO=seu.email@gmail.com